{
  "name": "@lurelog/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=../../.env dist/server.js",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@lurelog/shared": "*",
    "express": "^5.3.0",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "helmet": "^8.3.0",
    "express-rate-limit": "^8.7.1",
    "multer": "^2.5.0",
    "cloudinary": "^2.11.0",
    "sharp": "^0.35.5",
    "file-type": "^22.2.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "@types/node": "^26.6.5",
    "@types/express": "^5.0.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5",
    "mongodb-memory-server": "^11.3.0"
  }
}
