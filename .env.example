NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/lurelog?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# Required only when STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional, required for seed command. Seed never resets existing accounts.
SEED_EMAIL=angler@example.com
SEED_PASSWORD=
