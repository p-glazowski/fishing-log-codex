NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/lurelog?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
# Password recovery: local development saves messages under UPLOAD_DIR/dev-mail when SMTP_HOST is empty.
# Production requires SMTP_HOST, SMTP_FROM (bare verified email), SMTP_USER and SMTP_PASSWORD.
# Use port 587 with SMTP_SECURE=false (required STARTTLS), or 465 with true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# Required only when STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional, required for seed command. Seed never resets existing accounts.
SEED_EMAIL=angler@example.com
SEED_PASSWORD=
